{
  "name": "@dalin/kit",
  "version": "0.10.1",
  "description": "The shared design base of the dalin apps: tokens, the toast, the create button, the wordmark and family switcher, frosted menus, the command palette, the phone header and search, the segmented control, the filter, and the helpers each app had copied.",
  "type": "module",
  "license": "MIT",
  "author": "Samuel Gomez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomezsj12/dalin-kit.git"
  },
  "homepage": "https://github.com/gomezsj12/dalin-kit#readme",
  "bugs": {
    "url": "https://github.com/gomezsj12/dalin-kit/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "import": "./dist/toast/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./base.css": "./css/base.css",
    "./toast.css": "./css/toast.css",
    "./create.css": "./css/create.css",
    "./motion.css": "./css/motion.css",
    "./wordmark.css": "./css/wordmark.css",
    "./menu.css": "./css/menu.css",
    "./empty.css": "./css/empty.css",
    "./palette.css": "./css/palette.css",
    "./phone.css": "./css/phone.css",
    "./seg.css": "./css/seg.css",
    "./filter.css": "./css/filter.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:base-ui-next": "BASE_UI=next vitest run src/components",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "keywords": [
    "dalin",
    "design-tokens",
    "toast",
    "sonner",
    "base-ui",
    "command-palette",
    "react"
  ],
  "peerDependencies": {
    "@base-ui/react": "^1.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "base-ui-next": "npm:@base-ui/react@1.9.0",
    "jsdom": "^29.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "2.0.7",
    "sonner-next": "npm:sonner@2.0.8",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
