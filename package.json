{
  "name": "@dalin/kit",
  "version": "0.1.0",
  "description": "The shared design base of the dalin apps: tokens, the toast, the create button, and the helpers each app had copied.",
  "type": "module",
  "license": "MIT",
  "author": "Samuel Gomez",
  "repository": { "type": "git", "url": "git+https://github.com/gomezsj12/dalin-kit.git" },
  "homepage": "https://github.com/gomezsj12/dalin-kit#readme",
  "bugs": { "url": "https://github.com/gomezsj12/dalin-kit/issues" },
  "sideEffects": ["*.css"],
  "files": [
    "dist",
    "css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "import": "./dist/toast/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./toast.css": "./css/toast.css",
    "./create.css": "./css/create.css",
    "./motion.css": "./css/motion.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "keywords": [
    "dalin",
    "design-tokens",
    "toast",
    "sonner",
    "react"
  ],
  "peerDependencies": {
    "@base-ui/react": "^1.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^29.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "2.0.7",
    "sonner-next": "npm:sonner@2.0.8",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
